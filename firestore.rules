rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Pengurus/admin harus terdaftar sebagai dokumen pengurus dengan ID = UID Firebase.
    function isPengurus() {
      return signedIn() &&
        exists(/databases/$(database)/documents/pengurus/$(request.auth.uid));
    }

    // Data transparansi dapat dibaca oleh pengguna yang sudah terautentikasi melalui Phone Authentication.
    // Perubahan data hanya boleh dilakukan oleh UID pengurus yang terdaftar.
    match /transaksi/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isPengurus();
    }

    match /warga/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isPengurus();
    }

    // Profil pengurus tidak boleh dibuka publik. Pengurus dapat membaca profilnya
    // dan profil pengurus lain setelah terautentikasi; perubahan hanya oleh pengurus.
    match /pengurus/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isPengurus();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

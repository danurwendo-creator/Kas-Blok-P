rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPengurus() {
      return signedIn() &&
        exists(/databases/$(database)/documents/pengurus/$(request.auth.uid));
    }

    // Dashboard warga bersifat transparan dan dapat dibaca tanpa login.
    match /transaksi/{id} {
      allow read: if true;
      allow create, update, delete: if isPengurus();
    }

    match /warga/{id} {
      allow read: if true;
      allow create, update, delete: if isPengurus();
    }

    // Profil pengurus hanya dapat dibaca oleh akun yang sudah terautentikasi.
    // Perubahan profil hanya boleh dilakukan oleh pengurus yang sudah terdaftar.
    match /pengurus/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isPengurus());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if isPengurus();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

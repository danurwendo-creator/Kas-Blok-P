rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() && request.auth.token.email != null;
    }

    // Public transparency: residents can read financial and resident information.
    // Writes require an authenticated email/password account.
    match /transaksi/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /warga/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    // Only basic public profile information is stored here. Never store passwords.
    match /pengurus/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
